# ==============================================================================
# ParcelPath - Environment Configuration Template
# Placeholders only. Do NOT commit real secrets or production API keys.
# ==============================================================================

# Core Application URL (Set to your Vercel deployment URL, e.g. https://your-app.vercel.app)
APP_URL="https://your-parcelpath-deployment.vercel.app"
PORT="3000"
NODE_ENV="production"

# Gemini AI Studio Integration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Official Customer Care & Support Contacts (Managed by administrator)
# When left blank, ParcelPath displays an honest unavailable state for direct calling
# and routes users to the in-app Support Request form and Issues & Feedback desk.
SUPPORT_EMAIL="support@yourdomain.com"
SUPPORT_PHONE="+91 98765 43210"
SUPPORT_WHATSAPP="+91 98765 43210"
SUPPORT_HOURS="Mon–Sat: 9:00 AM – 7:00 PM IST"

# Courier Integration Keys (Optional live webhook & tracking endpoints)
DELHIVERY_API_KEY="your_delhivery_api_token"
BLUEDART_LICENSE_KEY="your_bluedart_license_key"
SHIPROCKET_API_KEY="your_shiprocket_token"
TRACK17_API_KEY="your_17track_api_key"

# Google Workspace / Gmail OAuth (Optional: for read-only order confirmation thumbnail extraction)
# In Google Cloud Console, authorize redirect URI: https://your-parcelpath-deployment.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Persistent Private Storage (Recommended for Vercel production deployment)
# Vercel Blob or S3-compatible bucket token for persistent screenshot attachments
# If unconfigured, attachments are stored as secure verified Base64 data within the ticket record
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
STORAGE_BUCKET_NAME="parcelpath-private-tickets"

# Database Persistence (Optional external relational database)
# If unconfigured, uses file/memory database seeded from data/db.json
DATABASE_URL="postgres://username:password@your-db-host.com:5432/parcelpath"

# Cron Security Secret (Optional: secures /api/cron/refresh-tracking on Vercel)
CRON_SECRET="your_custom_cron_secret_token"
